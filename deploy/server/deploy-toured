#!/usr/bin/env bash
set -Eeuo pipefail

umask 0007

readonly CONFIG_FILE="/etc/toured-deploy.conf"
readonly LOCK_FILE="/run/lock/toured-deploy.lock"

log() {
    printf '[toured-deploy] %s\n' "$*"
}

fail() {
    printf '[toured-deploy] ERROR: %s\n' "$*" >&2
    return 1
}

if [[ $EUID -ne 0 ]]; then
    fail "This command must run through sudo"
fi

load_configuration() {
    local config_mode
    local variable_name

    [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || fail "Configuration is missing: $CONFIG_FILE"
    [[ "$(stat --format '%u' "$CONFIG_FILE")" == 0 ]] || fail "Configuration must be owned by root"
    config_mode="$(stat --format '%a' "$CONFIG_FILE")"
    (( (8#$config_mode & 0022) == 0 )) || fail "Configuration must not be writable by group or others"

    # The file is root-owned and protected above; shell syntax keeps the server configuration simple.
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    for variable_name in DEPLOY_USER DEPLOY_HOME RUNTIME_USER RUNTIME_GROUP APP_DIR \
        BACKUP_ROOT DATABASE_FILE SERVICE_NAME DOTNET_PATH LISTEN_URL HEALTH_URL KEEP_BACKUPS; do
        [[ -v "$variable_name" ]] || fail "Missing configuration value: $variable_name"
        [[ -n "${!variable_name}" ]] || fail "Empty configuration value: $variable_name"
    done

    [[ "$DEPLOY_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "Invalid DEPLOY_USER"
    [[ "$RUNTIME_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "Invalid RUNTIME_USER"
    [[ "$RUNTIME_GROUP" =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "Invalid RUNTIME_GROUP"
    [[ "$DEPLOY_HOME" =~ ^/[A-Za-z0-9._/-]+$ && "$DEPLOY_HOME" != */ ]] || fail "Invalid DEPLOY_HOME"
    [[ "$APP_DIR" =~ ^/[A-Za-z0-9._/-]+$ && "$APP_DIR" != */ ]] || fail "Invalid APP_DIR"
    [[ "$BACKUP_ROOT" =~ ^/[A-Za-z0-9._/-]+$ && "$BACKUP_ROOT" != */ ]] || fail "Invalid BACKUP_ROOT"
    [[ "$DATABASE_FILE" =~ ^[A-Za-z0-9._-]+$ ]] || fail "Invalid DATABASE_FILE"
    [[ "$SERVICE_NAME" =~ ^[A-Za-z0-9_.@-]+\.service$ ]] || fail "Invalid SERVICE_NAME"
    [[ "$DOTNET_PATH" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "Invalid DOTNET_PATH"
    [[ "$LISTEN_URL" =~ ^https?://[A-Za-z0-9.:-]+$ ]] || fail "Invalid LISTEN_URL"
    [[ "$HEALTH_URL" =~ ^https?://[^[:space:]]+$ ]] || fail "Invalid HEALTH_URL"
    [[ "$KEEP_BACKUPS" =~ ^[0-9]+$ ]] || fail "Invalid KEEP_BACKUPS"
    ((KEEP_BACKUPS >= 1 && KEEP_BACKUPS <= 50)) || fail "KEEP_BACKUPS must be between 1 and 50"
}

for configuration_command in dirname stat; do
    command -v "$configuration_command" >/dev/null || fail "Required command is missing: $configuration_command"
done
load_configuration

readonly DEPLOY_USER DEPLOY_HOME RUNTIME_USER RUNTIME_GROUP APP_DIR BACKUP_ROOT DATABASE_FILE
readonly SERVICE_NAME DOTNET_PATH LISTEN_URL HEALTH_URL KEEP_BACKUPS
readonly APPS_ROOT="$(dirname "$APP_DIR")"
readonly DB_PATH="$APP_DIR/$DATABASE_FILE"
readonly INCOMING_DIR="$DEPLOY_HOME/incoming"
readonly ARCHIVE="$INCOMING_DIR/toured-release.tar.gz"
readonly CHECKSUM="$INCOMING_DIR/toured-release.tar.gz.sha256"

[[ "$BACKUP_ROOT" == "$APPS_ROOT/"* && "$BACKUP_ROOT" != "$APP_DIR" ]] || \
    fail "BACKUP_ROOT must be a separate directory below $APPS_ROOT"

staging_dir=""
backup_dir=""
rollback_required=0
service_stopped=0

healthcheck() {
    local attempt
    for attempt in {1..12}; do
        if curl --fail --silent --show-error --output /dev/null \
            --connect-timeout 5 --max-time 10 "$HEALTH_URL"; then
            return 0
        fi
        sleep 5
    done
    return 1
}

set_app_permissions() {
    chown -R "$RUNTIME_USER:$RUNTIME_GROUP" "$APP_DIR"
    find "$APP_DIR" -type d -exec chmod 2770 {} +
    find "$APP_DIR" -type f -exec chmod g+rw,o-rwx {} +
    chmod 0660 "$DB_PATH"
}

rollback() {
    log "Deployment failed; restoring application and database backup"
    systemctl stop "$SERVICE_NAME" || true

    if [[ -e "$APP_DIR" && ! -L "$APP_DIR" ]]; then
        mv "$APP_DIR" "$backup_dir/failed-app"
    fi

    if [[ ! -d "$backup_dir/app" ]]; then
        fail "Rollback copy is missing: $backup_dir/app"
        return 1
    fi

    mv "$backup_dir/app" "$APP_DIR"
    set_app_permissions
    systemctl start "$SERVICE_NAME"

    if healthcheck; then
        log "Rollback completed and healthcheck passed"
    else
        journalctl --unit "$SERVICE_NAME" --lines 30 --no-pager >&2 || true
        fail "Rollback completed, but the healthcheck still fails"
    fi
}

prune_backups() {
    local -a backups
    local index
    mapfile -t backups < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort --reverse)
    for ((index = KEEP_BACKUPS; index < ${#backups[@]}; index++)); do
        rm -rf -- "$BACKUP_ROOT/${backups[$index]}"
    done
}

on_exit() {
    local exit_code=$?
    trap - EXIT
    set +e

    if ((exit_code != 0 && rollback_required == 1)); then
        rollback || true
    elif ((exit_code != 0 && service_stopped == 1)); then
        log "Deployment failed before the backup completed; restarting the unchanged service"
        systemctl start "$SERVICE_NAME" || true
    fi

    if [[ -n "$staging_dir" && -d "$staging_dir" ]]; then
        rm -rf -- "$staging_dir"
    fi
    rm -f -- "$ARCHIVE" "$CHECKSUM"
    exit "$exit_code"
}

trap on_exit EXIT

for command_name in curl env find flock runuser sha256sum systemctl tar; do
    command -v "$command_name" >/dev/null || fail "Required command is missing: $command_name"
done

exec 9>"$LOCK_FILE"
flock --nonblock 9 || fail "Another TourEd deployment is already running"

[[ -f "$ARCHIVE" && ! -L "$ARCHIVE" ]] || fail "Release archive is missing"
[[ -f "$CHECKSUM" && ! -L "$CHECKSUM" ]] || fail "Release checksum is missing"

log "Verifying release checksum"
(
    cd "$INCOMING_DIR"
    sha256sum --check --strict "$(basename "$CHECKSUM")"
)

staging_dir="$(mktemp --directory "$APPS_ROOT/.toured-stage.XXXXXX")"
chown "$RUNTIME_USER:$RUNTIME_GROUP" "$staging_dir"
chmod 0700 "$staging_dir"
install -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0640 "$ARCHIVE" "$staging_dir/release.tar.gz"

log "Extracting release as $RUNTIME_USER"
runuser -u "$RUNTIME_USER" -- tar -xzf "$staging_dir/release.tar.gz" -C "$staging_dir" \
    --no-same-owner --no-same-permissions
rm -f "$staging_dir/release.tar.gz"

[[ -f "$staging_dir/app/Api.dll" ]] || fail "Release does not contain app/Api.dll"
[[ -f "$staging_dir/git-sha" ]] || fail "Release does not contain git-sha"

release_sha="$(tr -d '\r\n' < "$staging_dir/git-sha")"
[[ "$release_sha" =~ ^[0-9a-f]{40}$ ]] || fail "Release contains an invalid git SHA"

case "$(uname -m)" in
    x86_64) runtime_id="linux-x64" ;;
    aarch64 | arm64) runtime_id="linux-arm64" ;;
    *) fail "Unsupported server architecture: $(uname -m)" ;;
esac

migration_bundle="$staging_dir/migrations/$runtime_id/toured-migrate"
[[ -f "$migration_bundle" ]] || fail "Migration bundle for $runtime_id is missing"
chown "$RUNTIME_USER:$RUNTIME_GROUP" "$migration_bundle"
chmod 0750 "$migration_bundle"
bundle_extract_dir="$staging_dir/bundle-extract"
install -d -m 0700 -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" "$bundle_extract_dir"

[[ -d "$APP_DIR" && ! -L "$APP_DIR" ]] || fail "Application directory is missing or is a symlink"
[[ -f "$DB_PATH" && ! -L "$DB_PATH" ]] || fail "SQLite database is missing or is a symlink"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_dir="$(mktemp --directory "$BACKUP_ROOT/$timestamp-${release_sha:0:12}.XXXXXX")"
chown root:root "$backup_dir"
chmod 0700 "$backup_dir"

log "Stopping $SERVICE_NAME"
systemctl stop "$SERVICE_NAME"
service_stopped=1

log "Backing up application and SQLite database to $backup_dir"
mv "$APP_DIR" "$backup_dir/app"
rollback_required=1
cp -a "$backup_dir/app/$DATABASE_FILE" "$backup_dir/$DATABASE_FILE"

log "Installing release $release_sha"
mv "$staging_dir/app" "$APP_DIR"
install -o "$RUNTIME_USER" -g "$RUNTIME_GROUP" -m 0660 \
    "$backup_dir/$DATABASE_FILE" "$DB_PATH"
set_app_permissions

log "Applying Entity Framework migrations"
(
    cd "$APP_DIR"
    runuser -u "$RUNTIME_USER" -- env \
        DOTNET_BUNDLE_EXTRACT_BASE_DIR="$bundle_extract_dir" \
        "$migration_bundle" \
        --connection "Data Source=$DB_PATH"
)

log "Starting $SERVICE_NAME"
systemctl start "$SERVICE_NAME"

log "Waiting for production healthcheck"
if ! healthcheck; then
    journalctl --unit "$SERVICE_NAME" --lines 30 --no-pager >&2 || true
    fail "Production healthcheck failed"
fi

rollback_required=0
service_stopped=0
log "Deployment $release_sha completed successfully"
prune_backups || log "Warning: old backups could not be pruned"
